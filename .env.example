# === Requeridas (ver CLAUDE.md) ===============================================

# Google Gemini API key — obligatoria. Se usa solo en el servidor (esta variable
# de entorno); nunca se acepta ni se expone una key distinta desde el frontend.
GEMINI_API_KEY=

# Nº de jobs de recorte procesados en paralelo. En el VPS (6 vCPU, sin GPU) no
# subir de 2 para no saturar la máquina con varios pipelines de ffmpeg/whisper.
MAX_CONCURRENT_JOBS=2

# Modelo de faster-whisper. "small" o "medium" en CPU; no usar "large" en el VPS.
WHISPER_MODEL=small

# Horas que se conservan en disco el vídeo original, el audio intermedio y los
# clips de un job ya completado antes del borrado automático.
CLEANUP_RETENTION_HOURS=48

# Basic Auth HTTP a nivel de Caddy (ver Caddyfile) — protege la UI, no se
# gestiona dentro de la app.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Dominio final servido por Caddy con HTTPS automático (Let's Encrypt).
DOMAIN=youtube.omarpumariega.com

# === Ajustes técnicos del pipeline (opcionales) ================================

# CPU-only en el VPS: sin GPU no toques estas dos.
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Backend de transcripción: whisper (por defecto) | parakeet (solo GPU).
# TRANSCRIBE_BACKEND=whisper

# Encoder de vídeo para todos los cortes ffmpeg: x264 (por defecto, CPU) | nvenc | auto.
# FFMPEG_ENCODER=x264

# Cookies de YouTube en formato Netscape, opcional — evita bloqueos de bot en
# algunas descargas vía yt-dlp.
# YOUTUBE_COOKIES=

# Aviso antes de procesar una fuente de YouTube por debajo de esta altura
# (720p por defecto; 0 lo desactiva). Solo aplica a URLs, no a subidas directas.
# QUALITY_GATE_MIN_HEIGHT=720

# === Renderer (subtítulos/efectos vía Remotion) — normalmente no hace falta
# tocarlas, ya vienen fijadas en docker-compose.yml para el contenedor `renderer`.
# REMOTION_BUNDLE_PATH=/app/remotion
# OUTPUT_DIR=/output
# PORT=3100

# === Explícitamente eliminado del OpenShorts original (no aplica a este fork) =
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / AWS_S3_BUCKET / AWS_S3_PUBLIC_BUCKET
#   -> sin S3: todo el almacenamiento de clips es disco local del VPS, con
#      limpieza automática (CLEANUP_RETENTION_HOURS).
# OAUTH_REDIRECT_URI / FRONTEND_URL (Google OAuth)
#   -> sin login/multi-usuario; el acceso se protege con Basic Auth en Caddy.
# VITE_OPENPANEL_API_URL / VITE_OPENPANEL_CLIENT_ID (analítica de producto)
#   -> no se usa ninguna analítica de terceros.
# BILLING_ENABLED
#   -> no existe: el paquete cloud/ (multi-usuario, billing, keys gestionadas)
#      se eliminó por completo de este fork.
