# Reverse proxy + TLS for the Clip Generator instance.
#
# {$DOMAIN} comes straight from .env. Basic auth is OPTIONAL: if
# BASIC_AUTH_USER/BASIC_AUTH_PASSWORD are set, caddy/docker-entrypoint.sh
# hashes the password (bcrypt) and writes the auth block into
# /etc/caddy/auth.caddy; if they are unset, that snippet is empty and the
# site is served with no authentication.
{$DOMAIN} {
	import /etc/caddy/auth.caddy

	# Clip delivery and the pipeline API — everything else is the SPA.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /videos/* {
		reverse_proxy backend:8000
	}
	handle /thumbnails/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}
