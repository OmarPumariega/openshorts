# Reverse proxy + TLS for the private Clip Generator instance.
#
# {$DOMAIN} / {$BASIC_AUTH_USER} come straight from .env. The password hash
# is NOT read from an env var directly — Caddy's basic_auth needs a bcrypt
# hash, but CLAUDE.md's contract is a plain BASIC_AUTH_PASSWORD in .env, so
# caddy/docker-entrypoint.sh hashes it once at container start and exports
# BASIC_AUTH_PASSWORD_HASH before caddy reads this file. Never put a plain
# password in this file or commit a hash to version control.
{$DOMAIN} {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_PASSWORD_HASH}
	}

	# Clip delivery and the pipeline API — everything else is the SPA.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /videos/* {
		reverse_proxy backend:8000
	}
	handle /thumbnails/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}
